<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/song_tonality_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tonality_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/song_tonality_verdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tonality_verdict"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSecondaryContainer"
                tools:text="Balanced" />
        </LinearLayout>

        <TextView
            android:id="@+id/song_tonality_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:text="Fast Car · Tracy Chapman"
            tools:visibility="visible" />

        <!-- Reference picker and actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/song_tonality_reference"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:contentDescription="@string/tonality_reference_mode"
                app:icon="@drawable/ic_baseline_arrow_drop_down_24dp"
                app:iconGravity="textEnd"
                app:iconPadding="0dp"
                tools:text="vs IEC noise" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/song_tonality_hold"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:contentDescription="@string/tonality_hold"
                android:tooltipText="@string/tonality_hold"
                app:icon="@drawable/ic_baseline_pause_24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/song_tonality_reset"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/tonality_reset"
                android:tooltipText="@string/tonality_reset"
                app:icon="@drawable/ic_baseline_refresh_24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/song_tonality_settings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/tonality_settings_header"
                android:tooltipText="@string/tonality_settings_header"
                app:icon="@drawable/ic_tune_vertical_variant_24dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/song_tonality_descriptor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/tonality_waiting"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Bass +5.2 dB, Air −7.1 dB beyond the normal range." />

        <LinearLayout
            android:id="@+id/song_tonality_bands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal" />

        <me.timschneeberger.rootlessjamesdsp.view.MNoiseDeviationSurface
            android:id="@+id/mnoise_deviation_surface"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="30dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/song_tonality_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/song_tonality_view_song"
                    style="@style/Widget.Tonality.ToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tonality_view_song" />

                <Button
                    android:id="@+id/song_tonality_view_live"
                    style="@style/Widget.Tonality.ToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tonality_view_live" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/song_tonality_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/song_tonality_display_compensated"
                    style="@style/Widget.Tonality.ToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tonality_display_compensated" />

                <Button
                    android:id="@+id/song_tonality_display_raw"
                    style="@style/Widget.Tonality.ToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tonality_display_raw" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <TextView
            android:id="@+id/song_tonality_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="42 s analyzed · content from 62 Hz · cut off at 16.0 kHz" />

        <LinearLayout
            android:id="@+id/song_tonality_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/song_tonality_notice_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="@string/tonality_notification_access" />

            <Button
                android:id="@+id/song_tonality_notice_action"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tonality_notification_access_grant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
